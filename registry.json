        },
        {
          "path": "components/dashboard/recent-orders-table.tsx",
          "type": "registry:component",
          "target": "components/dashboard/recent-orders-table.tsx"
        },
        {
          "path": "components/dashboard/activity-feed.tsx",
          "type": "registry:component",
          "target": "components/dashboard/activity-feed.tsx"
        },
        {
          "path": "lib/dashboard/types.ts",
          "type": "registry:lib",
          "target": "lib/dashboard/types.ts"
        },
        {
          "path": "lib/dashboard/format.ts",
          "type": "registry:lib",
          "target": "lib/dashboard/format.ts"
        },
        {
          "path": "lib/dashboard/fixtures.ts",
