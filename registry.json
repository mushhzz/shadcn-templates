  "items": [
    {
      "name": "tokens",
      "type": "registry:theme",
      "title": "Status tokens",
      "description": "Semantic success, warning and info colours (AA contrast) exposed as Tailwind utilities: text-success, bg-warning/15, etc.",
      "cssVars": {
        "theme": {
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)",
          "color-info": "var(--info)",
          "color-info-foreground": "var(--info-foreground)"
        },
        "light": {
          "success": "oklch(0.48 0.15 150)",
          "success-foreground": "oklch(0.985 0 0)",
          "warning": "oklch(0.5 0.16 49)",
          "warning-foreground": "oklch(0.985 0 0)",
          "info": "oklch(0.488 0.243 264.376)",
          "info-foreground": "oklch(0.985 0 0)"
        },
        "dark": {
          "success": "oklch(0.792 0.209 151.711)",
          "success-foreground": "oklch(0.145 0 0)",
          "warning": "oklch(0.828 0.189 84.429)",
          "warning-foreground": "oklch(0.145 0 0)",
          "info": "oklch(0.707 0.165 254.624)",
          "info-foreground": "oklch(0.145 0 0)"
        }
      },
      "files": []
    },
