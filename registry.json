      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "avatar"
      ],
      "files": [
        {
          "path": "components/blocks/message-list.tsx",
          "type": "registry:component",
          "target": "components/blocks/message-list.tsx"
        }
      ]
    },
